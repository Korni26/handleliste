rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isApprovedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/validUsers/$(request.auth.uid));
    }

    match /validUsers/{userId} {
      // Signed-in users can read only their own approval record.
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // Named shopping lists are shared by the same approved users as products.
    match /shoppingLists/{listId} {
      allow read, delete: if isApprovedUser();
      allow create: if isApprovedUser()
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.keys().hasAll(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 32;
      allow update: if isApprovedUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 32;
    }

    match /products/{productId} {
      allow read, write: if isApprovedUser();
    }
  }
}
